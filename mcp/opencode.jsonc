// Template: Context7 + DeepWiki MCP servers for OpenCode.
// User level: ~/.config/opencode/opencode.json(c)
// Project level: <project>/opencode.json(c)
//
// Merge this "mcp" block, or run setup-mcp.sh / setup-mcp.ps1.
// Both servers are keyless. To raise Context7's rate limits, add an
// Authorization header with an API key from context7.com.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      }
    }
  }
}
